      <!-- Instagram (Active) -->
       <a
        href="https://www.etsy.com/shop/FeralForged"
        class="cs-social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Shop Feral Forged Art on Etsy"
      >
        <span class="cs-social-text">FeralForged on Etsy</span>
      </a>
      <a
        href="https://instagram.com/feral.forged"
        class="cs-social-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visit our Instagram"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="currentColor"
          viewBox="0 0 16 16"
        >
