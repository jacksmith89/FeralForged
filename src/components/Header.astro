          ></path>
        </svg>
        <span class="cs-social-text">@feral.forged</span>
      </a>

      <!-- Facebook (Commented Out) -->
      <a
        href="tel:+12045550199"
        class="cs-social-link"
        aria-label="Call Feral Forged Art"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          fill="currentColor"
          viewBox="0 0 16 16"
        >
          <path
            d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z"
          ></path>
          <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2"></path>
        </svg>
        <span class="cs-social-text">Call Us</span>
      </a>

      <!-- Email (Commented Out) -->
      
    </div>
  </div>
</header>

<style lang="less">
  #main-header {
    width: 100%;
    background-color: #1c1a17;
    border-bottom: 1px solid rgba(138, 154, 134, 0.15);
    padding: (20/16rem) 0;

    .cs-container {
      width: 100%;
      max-width: (1322/16em);
      margin: auto;
      padding: 0 (16/16rem);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: (20/16rem);

      @media only screen and (max-width: 44rem) {
        flex-direction: column;
        text-align: center;
      }
    }

    .cs-logo {
      font-family: "Cinzel", serif;
      font-size: (20/16rem);
      font-weight: 600;
      color: #f4f0ea;
      text-decoration: none;
      letter-spacing: 0.12em;
      white-space: nowrap;
    }

    .cs-social-group {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      gap: (24/16rem);
    }

    .cs-social-link {
      color: #8a9a86;
      display: inline-flex;
      align-items: center;
      gap: (8/16rem);
      text-decoration: none;

      /* Add these to create the default container shape */
      background-color: transparent;
      padding: (6/16rem) (12/16rem);
      border-radius: 0.5rem;

      /* Update transition to smoothly animate the background change */
      transition:
        color 0.3s ease,
        background-color 0.3s ease,
        transform 0.3s ease;

      svg {
        flex-shrink: 0;
      }

      &:hover {
        color: #6b1d1d; /* Oxblood Red text/icon */
        background-color: #f4f0ea; /* Bone White background capsule */
        transform: translateY(-1px);
      }
    }

    .cs-social-text {
      font-family: "Cormorant Garamond", serif;
      font-size: (24/16rem);
      font-weight: 700;
    }
  }
</style>
